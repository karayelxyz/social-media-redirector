{
  "manifest_version": 3,
  "name": "Social Media Redirector",
  "version": "1.2.1",
  "description": "Redirects Instagram, X, TikTok, Threads to alternative front-ends.",
  "homepage_url": "https://karayelxyz.github.io/social-media-redirector",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://instagram.com/*",
    "*://*.x.com/*",
    "*://x.com/*",
    "*://*.tiktok.com/*",
    "*://tiktok.com/*",
    "*://exporttok.com/*",
    "*://kittygram.irelephant.net/*",
    "*://shitter.thepixora.com/*",
    "*://www.threads.com/*",
    "*://threads.com/*",
    "*://shoelace.mint.lgbt/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://instagram.com/*",
        "*://*.x.com/*",
        "*://x.com/*",
        "*://*.tiktok.com/*",
        "*://tiktok.com/*",
        "*://www.threads.com/*",
        "*://threads.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Social Media Redirector" },
  "icons": { "16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png" }
}
