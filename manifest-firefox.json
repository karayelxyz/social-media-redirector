{
  "manifest_version": 3,
  "name": "Social Media Redirector",
  "version": "1.0.1",
  "description": "Redirects Instagram, X, TikTok, Threads to privacy front-ends (imginn, nitter, exporttok, shoelace).",
  "homepage_url": "https://karayelxyz.github.io/social-media-redirector",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://instagram.com/*",
    "*://x.com/*",
    "*://*.tiktok.com/*",
    "*://tiktok.com/*",
    "*://exporttok.com/*",
    "*://imginn.com/*",
    "*://nitter.us.catsarch.com/*",
    "*://www.threads.com/*",
    "*://threads.com/*",
    "*://shoelace.mint.lgbt/*"
  ],
  "background": { "scripts": ["background.js"] },
  "action": { "default_popup": "popup.html", "default_title": "Social Media Redirector" },
  "icons": { "16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "social-media-redirector@karayel.xyz",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
